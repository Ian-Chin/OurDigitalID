rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /scanned_documents/{docId} {
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    match /flood_stations/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Ephemeral handoff for id-card.html autofill via QR. Session id is a
    // random UUID so it acts as the access secret. Anyone with the token may
    // create/read/update; not used for sensitive data beyond profile fields
    // the user themselves chose to share by scanning.
    match /id_card_sessions/{token} {
      allow read, create, update: if true;
      allow delete: if false;
    }
  }
}
